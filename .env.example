# Google Gemini API Key (Required for automated LLM summaries & quality verification)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (Default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Optional: Groq Cloud API Key for sub-second cloud ASR fallback on videos without subtitles
GROQ_API_KEY=
